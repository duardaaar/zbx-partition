# Parâmetros do zbx-partition.bash

# --- Conexão com o banco (OBRIGATÓRIO) ---
# Use o dono das tabelas, normalmente "zabbix"
ZBX_DB_HOST=localhost
ZBX_DB_PORT=5432
ZBX_DB_NAME=zabbix
ZBX_DB_USER=zabbix
ZBX_DB_PASS=sua_senha_aqui

# --- Tudo abaixo é OPCIONAL (os valores mostrados são os padrões) ---

# Retenção em dias. Todas as partições são diárias: a cada execução,
# os dias mais antigos que a retenção são apagados.
ZBX_PART_HISTORY_DAYS=90
ZBX_PART_TRENDS_DAYS=90

# Quantos dias de partições futuras manter criados (folga se o timer falhar)
ZBX_PART_HISTORY_PREMAKE=7
ZBX_PART_TRENDS_PREMAKE=7

# Tabelas particionadas
ZBX_PART_HISTORY_TABLES=history history_uint
ZBX_PART_TRENDS_TABLES=trends trends_uint

# Horário diário do timer (formato OnCalendar do systemd)
ZBX_PART_ONCALENDAR=*-*-* 03:30:00
